# Database Configuration (PostgreSQL Async via psycopg)
DATABASE_URL=postgresql+psycopg://username:password@localhost:5432/nse_screener_db

# FYERS API v3 Credentials
FYERS_CLIENT_ID=YOUR_APP_ID-100
FYERS_SECRET_KEY=YOUR_SECRET_KEY
FYERS_REDIRECT_URI=https://trade.fyers.in/api-login/redirect-uri/index.html

# FYERS Tokens (Generated via scripts/generate_token.py or auto-login)
FYERS_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
FYERS_REFRESH_TOKEN=YOUR_REFRESH_TOKEN

# Optional: Automated Daily Login Credentials (used by scripts/auto_login.py)
# FYERS_FY_ID=YOUR_FY_ID
# FYERS_PIN=YOUR_4_DIGIT_PIN
# FYERS_TOTP_KEY=YOUR_TOTP_SECRET_KEY
